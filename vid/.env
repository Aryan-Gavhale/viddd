# ===========================================
# Vidlancing Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@10.19.219.175:5432/Vidlancing

# Pool tuning — lower DB_POOL_MAX behind PgBouncer (e.g. 10)
DB_POOL_MAX=20
DB_POOL_MIN=2

# Authentication
# IMPORTANT: Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=a5a72cfaaa6313ed419a3187414e73e71da6e2e8e1a090f3814d6827bac1075a4722455e4ce4cb885e0aaa84d99c33bdc9dbf8c6a732b631ae9d424e8713a58e
# Must differ from JWT_SECRET, at least 32 chars. Required in production.
JWT_REFRESH_SECRET=e37376a151886e37689d3d7080d1b5efaa8c5fc1074d3c8d9d7213bcfabb56c2735c583877945634efaab30a2e65960d10ee00ecaa445c881fafa1bdac10174a
# Used to sign cookies. Must not equal JWT_SECRET.
COOKIE_SECRET=7d9fe960613c42cb53a91a6d3a073534c1519e7b5567e1fd37373f3a1a217035b9c131f20acd65883722b291c9e05fdcf73e884b9e644d4d38f8ae8c4f45848d

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Redis (for caching, rate limiting, Bull queues, and account lockout)
REDIS_URL=redis://localhost:6379
# Optional: password for Redis ACL
# REDIS_PASSWORD=
# Set to "false" to disable TLS cert verification (not recommended for production)
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=vidlancing-uploads

# Stripe (payments)
# Leave empty to use the local fake checkout below; fill with sk_test_... when
# you have Stripe test keys handy. The /orders/:id/checkout/session route
# falls back to the local-dev path automatically when STRIPE_SECRET_KEY is
# empty and ALLOW_LOCAL_FAKE_CHECKOUT=true.
STRIPE_SECRET_KEY=
# Required for webhook signature verification (only when STRIPE_SECRET_KEY is set)
STRIPE_WEBHOOK_SECRET=

# Dev-only: allow the local fake checkout endpoint when Stripe is not
# configured. NEVER set this to true in production — the prod guard in
# payment.service.ts also refuses to honour it, but keep it false in any
# shared/staging env so a missing Stripe key fails loud instead of silently
# marking orders as paid.
ALLOW_LOCAL_FAKE_CHECKOUT=true

# Email (Nodemailer)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# App URL (used in email verification links; some modules use FRONTEND_URL)
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Sentry (optional — error monitoring / APM)
# SENTRY_DSN=
