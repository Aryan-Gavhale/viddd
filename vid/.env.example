# ===========================================
# Vidlancing Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/vidlancing?schema=public
# Pool tuning — lower DB_POOL_MAX behind PgBouncer (e.g. 10)
DB_POOL_MAX=20
DB_POOL_MIN=2

# Authentication
# IMPORTANT: Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Must differ from JWT_SECRET, at least 32 chars. Required in production.
JWT_REFRESH_SECRET=
# Used to sign cookies. Must not equal JWT_SECRET.
COOKIE_SECRET=

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Redis (for caching, rate limiting, Bull queues, and account lockout)
REDIS_URL=redis://localhost:6379
# Optional: password for Redis ACL
# REDIS_PASSWORD=
# Set to "false" to disable TLS cert verification (not recommended for production)
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=vidlancing-uploads

# Stripe (payments)
STRIPE_SECRET_KEY=
# Required for webhook signature verification
STRIPE_WEBHOOK_SECRET=

# Email (Nodemailer)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# App URL (used in email verification links; some modules use FRONTEND_URL)
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Sentry (optional — error monitoring / APM)
# SENTRY_DSN=
