# ===========================================
# Vidlancing Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# Backend API URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Dev-only: surfaces the amber "Local development mode — no real payment"
# banner on /checkout/.../payment so testers know clicking continue won't
# charge a card. Must match ALLOW_LOCAL_FAKE_CHECKOUT in the backend .env.
# Set to false (or unset) once real Stripe test keys are configured.
VITE_ALLOW_LOCAL_FAKE_CHECKOUT=true
